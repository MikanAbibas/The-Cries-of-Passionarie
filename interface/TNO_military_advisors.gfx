spriteTypes = {

	# Military Advisors window in the deployment tab (TNO_military_advisors.gui).
	# Textures are built by z_plans/advisor_gui/build_textures.py from the mockup's drawing code.

	spriteType = {
		name = "GFX_TNO_military_advisors_bg"
		texturefile = "gfx/interface/military_advisors/military_advisors_bg.dds"
	}

	# frame = level + 1: frame 1 is level 0 (blank plate), frames 2-6 the advisor idea art for levels 1-5
	spriteType = {
		name = "GFX_TNO_military_advisors_level"
		texturefile = "gfx/interface/military_advisors/military_advisors_level_strip.dds"
		noOfFrames = 6
	}

	# frame = level + 1: frame n shows n-1 of 5 pips filled
	spriteType = {
		name = "GFX_TNO_military_advisors_pips"
		texturefile = "gfx/interface/military_advisors/military_advisors_pips.dds"
		noOfFrames = 6
	}

	# frame = days left + 1, out of a 30-day term
	spriteType = {
		name = "GFX_TNO_military_advisors_term_bar"
		texturefile = "gfx/interface/military_advisors/military_advisors_term_bar.dds"
		noOfFrames = 31
	}

	# hover, press and the greyed-out disabled state come from the shader
	spriteType = {
		name = "GFX_TNO_military_advisors_button"
		texturefile = "gfx/interface/military_advisors/military_advisors_button.dds"
		noOfFrames = 1
		effectFile = "gfx/FX/buttonstate.lua"
	}

	# drawn in the Raise button's place at level 5; not a button
	spriteType = {
		name = "GFX_TNO_military_advisors_button_max"
		texturefile = "gfx/interface/military_advisors/military_advisors_button_max.dds"
	}
}
