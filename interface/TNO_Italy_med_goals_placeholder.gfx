### Placeholder focus icons for the Mediterranean Italy rework.
###
### These 37 icon names are referenced by imported focuses but no art for them
### exists in either branch. Rather than editing 37 focus definitions, each name
### is defined here pointing at a path-appropriate, shine-safe GFX_Generic_*
### texture. When real art arrives, change the texturefile here and nothing else.
###
### Per convention no vanilla GFX_goal_* sprite is used, and every entry has a
### matching _shine so the engine's automatic shine lookup does not error.

spriteTypes = {

	# GFX_A_Quiet_Night_In -> GFX_Generic_Peace
	SpriteType = {
		name = "GFX_A_Quiet_Night_In"
		texturefile = "gfx/interface/goals/Generic_Peace.dds"
	}

	SpriteType = {
		name = "GFX_A_Quiet_Night_In_shine"
		texturefile = "gfx/interface/goals/Generic_Peace.dds"
		effectFile = "gfx/FX/buttonstate.lua"
		animation = {
			animationmaskfile = "gfx/interface/goals/Generic_Peace.dds"
			animationtexturefile = "gfx/interface/goals/shine_overlay.dds"
			animationrotation = -90.0
			animationlooping = no
			animationtime = 0.75
			animationdelay = 0
			animationblendmode = "add"
			animationtype = "scrolling"
			animationrotationoffset = { x = 0 y = 0 }
