guiTypes = {

	# ---------------------------------------------------------------------------------
	# The toggle, in the right-click country view. Sits beside the header, left of
	# opinion_info (x311) and the stability / war support boxes (x400 and x444).
	# The window is exactly the button's native size, so the label centres itself.
	# ---------------------------------------------------------------------------------
	containerWindowType = {
		name = "TNO_bloc_aid_button_window"
		position = { x = 180 y = 2 }
		size = { width = 123 height = 34 }

		buttonType = {
			name = "bloc_aid_toggle"
			spriteType = "GFX_tno_button_123x34"
			position = { x = -160 y = -13 }
			buttonText = "BLOC_AID_BUTTON"
			buttonFont = "aldrich_16_outline"
			pdx_tooltip = "BLOC_AID_BUTTON_TT"
			clicksound = click_default
			orientation = LEFT
		}
	}

	# ---------------------------------------------------------------------------------
	# The panel, inside the diplomacy tab. It CANNOT hang outside countrydiplomacyview:
	# that window clips its children, so any negative x renders nothing at all. (Compare
	# countrytechnologyview.gui, which carries an explicit "clipping = no" precisely so
	# TNO_research_focus_window can hang off its right edge.)
	# Furniture from TNO_research_focus_window: background at the TOP LEVEL of the window
	# (nested, it does not draw), close button on ESCAPE.
	# Column budget per row: icon 16-38, name 46-196, cost 200-380 (right), button 392-515.
	# ---------------------------------------------------------------------------------
	containerWindowType = {
		name = "TNO_bloc_aid_panel_window"
		position = { x = 10 y = 206 }
		size = { width = 530 height = 432 }
		show_sound = open_sub_window
		moveable = no
		click_to_front = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_bg"
		}

		iconType = {
			name = "bloc_aid_header_strip"
			spriteType = "GFX_tiled_header"
			position = { x = 0 y = 0 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "bloc_aid_title"
			position = { x = 16 y = 10 }
			font = "aldrich_20_outline"
			borderSize = { x = 0 y = 0 }
			text = "BLOC_AID_TITLE"
			maxWidth = 380
			maxHeight = 24
			format = left
		}

		buttonType = {
			name = "bloc_aid_close"
			position = { x = -30 y = 8 }
			quadTextureSprite = "GFX_crt_closebutton"
			orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
			pdx_tooltip = "BLOC_AID_CLOSE_TT"
			clicksound = click_close
		}

		instantTextBoxType = {
			name = "bloc_aid_note"
