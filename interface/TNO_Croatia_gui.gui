guiTypes = {

	# Government Control bar — shown on the CRO_government_control decision category.
	# Cloned from the G4 econ_dev progress window; bound in TNO_Croatia_gui.txt.
	containerWindowType = {
		name = "CRO_gov_control_window"
		size = { width = 525 height = 120 }
		position = { x = 0 y = 0 }

		# iconType = {
		# 	name = "CRO_gov_control_box"
		# 	spriteType = "GER_progress_bar_box"
		# 	position = { x = 0 y = -30 }
		# 	orientation = UPPER_LEFT
		# 	alwaystransparent = yes
		# 	scale = 0.9
		# }
		iconType = {
			name = "global.CRO_gov_control_bar"
			spriteType = "CRO_gov_control_bar"
			position = { x = 25 y = 20 }
			scale = 1
			orientation = LEFT
		}
		iconType = {
			name = "CRO_gov_control_frame"
			spriteType = "GAY_Militarization_GUI_Bar_Frame"
			position = { x = 25 y = 20 }
			scale = 0.99
			orientation = LEFT
		}
		# Coup-threshold marker at the 25% point (x = 25 + 0.25*448 = 137).
		instantTextBoxType = {
			name = "CRO_gov_control_coup_marker"
			position = { x = 137 y = 15 }
			font = "aldrich_36_outline"
			text = CRO_gov_control_coup_marker
			maxWidth = 20
			format = centre
			tooltip = "CRO_gov_control_coup_marker_tt"
		}
		instantTextBoxType = {
			name = "CRO_gov_control_status_text"
			position = { x = 25 y = 80 }
			font = "aldrich_24_outline"
			text = "[ROOT.CROGetGovControlText]"
			maxWidth = 448
			format = centre
		}
		instantTextBoxType = {
			name = "CRO_italian_power_text"
			position = { x = 25 y = 102 }
			font = "aldrich_24_outline"
			text = CRO_italian_power_display_text
			maxWidth = 448
			format = centre
		}
	}

	# Titotangle — Tito/Hebrang/Bakaric leadership struggle. Reuses the generic tangle sprites.
	# Bound in TNO_Croatia_gui.txt; shown on the CRO_titotangle decision category.
	containerWindowType = {
		name = "CRO_titotangle_window"
		size = { width = 500 height = 450 }
		position = { x = 0 y = 0 }

		iconType = {
			name = "CRO_Tito_Tangle_Outline"
			spriteType = "GFX_tangle_outline"
			position = { x = 38 y = 25 }
		}
		iconType = {
			name = "CRO_Tito_Tangle_Dot"
			spriteType = "GFX_tangle_dot"
			position = { x = 38 y = 25 }
		}
		instantTextboxType = {
			name = "CRO_Tangle_BAKARIC"
			position = { x = 186 y = 0 }
			font = "aldrich_24_outline"
			text = "CRO_BAKARIC"
			alwaystransparent = yes
			pdx_tooltip = "CRO_BAKARIC_tt"
		}
		instantTextboxType = {
			name = "CRO_Tangle_TITO"
			position = { x = 20 y = 418 }
			font = "aldrich_24_outline"
			text = "CRO_TITO"
			alwaystransparent = yes
			maxWidth = 300
			maxHeight = 300
			fixedsize = yes
			pdx_tooltip = "CRO_TITO_tt"
		}
		instantTextboxType = {
			name = "CRO_Tangle_HEBRANG"
			position = { x = 398 y = 418 }
			font = "aldrich_24_outline"
			text = "CRO_HEBRANG"
			alwaystransparent = yes
			maxWidth = 300
			maxHeight = 300
			fixedsize = yes
			pdx_tooltip = "CRO_HEBRANG_tt"
		}
	}

	# Leadership race — the Ustase succession struggle. Bar-only clone of the OOSG
