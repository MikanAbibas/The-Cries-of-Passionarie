### Four buttons the Camera borrows from the French Assemblee.
###
### interface/ita_mechanics/TNO_Italy_Camera.gui asks for these by their FRA
### names, but the file that defines them belongs to the mediterranean branch's
### France content, which is not imported. Without them the Camera has no exit
### button, no info button and no page arrows.
spriteTypes = {
	spriteType = {
		name = "GFX_fra_info_button"
		texturefile = "gfx/interface/fra_mechanics/fra_assemblee/info_button.dds"
	}
	spriteType = {
		name = "GFX_fra_page_prev"
		texturefile = "gfx/interface/fra_mechanics/fra_assemblee/page_prev.dds"
	}
	spriteType = {
		name = "GFX_fra_page_next"
		texturefile = "gfx/interface/fra_mechanics/fra_assemblee/page_next.dds"
	}
	spriteType = {
		name = "GFX_FRA_gui_the_assemblee_nationale_exit_button"
		texturefile = "gfx/interface/fra_mechanics/fra_assemblee/exit_button.dds"
	}
}
