### Sub-ideology icons.
###
### The engine looks up GFX_ideology_<subtype> for a country leader whose ideology
### carries a subtype; without a sprite it falls back to the parent group icon.
### These cover the sub-ideologies for which art exists in the wider TNO codebase.
###
### A new file rather than an edit to an existing .gfx: sprite names are global,
### so this cannot disturb anything already defined.

spriteTypes = {

