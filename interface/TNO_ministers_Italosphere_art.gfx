		texturefile = "gfx/interface/ideas/EGY/GFX_EGY_Minister_Fouad_Serageddin.dds"
	}
	### Balbo governs Egypt from Rome; the same portrait his Italian seat uses.
	spriteType = {
		name = "GFX_idea_EGY_Italo_Balbo_hog"
