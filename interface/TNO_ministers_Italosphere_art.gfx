	}
	spriteType = {
		name = "GFX_idea_EGY_Minister_Abdel_Latif_Boghdadi_eco"
		texturefile = "gfx/interface/ideas/EGY/GFX_EGY_Minister_Abdel_Latif_Boghdadi.dds"
	}
	spriteType = {
